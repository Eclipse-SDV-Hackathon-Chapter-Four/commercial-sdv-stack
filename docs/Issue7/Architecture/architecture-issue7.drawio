        <mxCell id="nProfiles3" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=8;" value="COMPOSE PROFILES&#xa;• infra: dozzle, mosquitto, spire-server, spire-agents&#xa;• fw-update: symphony-api/portal/agent, ecu-updater 0.1.1&#xa;• powertrain: fms, ptc, sovd-cda, ecu-sim, databroker, vehicle-properties&#xa;&#xa;docker compose --profile infra --profile powertrain up -d" vertex="1">
