        <mxCell id="nDbroker3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontStyle=1;" value="databroker&#xa;Kuksa VAL · gRPC :55555&#xa;VSS: + SupportedModes" vertex="1">
          <mxGeometry height="60" width="200" x="720" y="620" as="geometry" />
        </mxCell>
        <mxCell id="nPtc3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=11;fontStyle=1;" value="powertrain-mode-controller (CHANGED, issue 7)&#xa;JWT-SVID + OPA authz.rego (unchanged)&#xa;SOVD client via Unix socket · ECU lock per write&#xa;user 10002:10100 · vehicle-uprotocol only" vertex="1">
          <mxGeometry height="80" width="240" x="70" y="625" as="geometry" />
        </mxCell>
        <mxCell id="nSocket3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=10;fontStyle=1;" value="volume cda-sovd-socket (NEW)&#xa;/run/cda/cda.sock · dir 0750 · sock 0770&#xa;B3/B6: lock → PUT → release&#xa;Bearer JWT-SVID · ptc mounts ro" vertex="1">
          <mxGeometry height="80" width="230" x="330" y="612" as="geometry" />
        </mxCell>
        <mxCell id="nCda3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=11;fontStyle=1;" value="sovd-cda (CHANGED, issue 7)&#xa;CDA fork 58f0c90 + spiffe_security_plugin&#xa;JWT-SVID (aud: sovd.cda) + lock + OPA authz.rego&#xa;NO TCP port · SOVD/HTTP over Unix socket&#xa;user 10001:10100 · cap_drop ALL" vertex="1">
          <mxGeometry height="100" width="240" x="70" y="790" as="geometry" />
        </mxCell>
        <mxCell id="nEcusim3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontStyle=1;" value="ecu-sim&#xa;Simulated ECU (blueprint-ecu)&#xa;DoIP + Control HTTP :8181" vertex="1">
          <mxGeometry height="70" width="210" x="70" y="950" as="geometry" />
